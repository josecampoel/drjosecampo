<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dr. José Campo · Medicina Integral</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --green-dark: #0A5E48;
      --green-mid: #1D9E75;
      --green-light: #E1F5EE;
      --green-pale: #f0faf6;
      --text-primary: #111813;
      --text-secondary: #4B6358;
      --text-muted: #8AADA0;
      --border: #D4EDE4;
      --white: #ffffff;
      --bg-soft: #F7FCF9;
      --font-display: 'DM Serif Display', Georgia, serif;
      --font-body: 'DM Sans', sans-serif;
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 22px;
      --radius-xl: 32px;

      /* card accent colors */
      --card-sleep-bg: #EEF4FF;
      --card-sleep-accent: #4B72D8;
      --card-gut-bg: #FFF4ED;
      --card-gut-accent: #D46A2A;
      --card-hormones-bg: #FFF0F5;
      --card-hormones-accent: #C44E7E;
      --card-head-bg: #F2F0FF;
      --card-head-accent: #6A4FC8;
      --card-sport-bg: #EDFAF3;
      --card-sport-accent: #1D9E75;
    }

    html { scroll-behavior: smooth; }
    body { font-family: var(--font-body); background: var(--white); color: var(--text-primary); overflow-x: hidden; }

    /* ── NAVBAR ── */
    nav {
      position: sticky; top: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 48px; height: 64px;
      background: rgba(255,255,255,0.92);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
    }
    .nav-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; }
    .nav-logo-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--green-mid); }
    .nav-logo-text { font-family: var(--font-body); font-size: 14px; font-weight: 600; color: var(--text-primary); letter-spacing: -0.01em; }
    .nav-links { display: flex; align-items: center; gap: 28px; }
    .nav-links a { font-size: 13.5px; color: var(--text-secondary); text-decoration: none; font-weight: 400; transition: color 0.2s; }
    .nav-links a:hover { color: var(--green-dark); }
    .nav-cta {
      background: var(--green-dark); color: #fff;
      border: none; border-radius: 100px;
      padding: 9px 22px; font-size: 13.5px; font-weight: 500;
      cursor: pointer; font-family: var(--font-body);
      transition: background 0.2s, transform 0.15s;
      text-decoration: none; display: inline-block;
    }
    .nav-cta:hover { background: var(--green-mid); transform: translateY(-1px); }

    /* ── HERO ── */
    .hero {
      min-height: 92vh;
      display: grid; grid-template-columns: 1fr 1fr;
      align-items: center; gap: 48px;
      padding: 64px 48px 64px;
      background: linear-gradient(160deg, var(--white) 0%, var(--green-pale) 55%, #dff5ec 100%);
      position: relative; overflow: hidden;
    }
    .hero::before {
      content: '';
      position: absolute; top: -120px; right: -120px;
      width: 500px; height: 500px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(29,158,117,0.1) 0%, transparent 70%);
      pointer-events: none;
    }
    .hero-left { position: relative; z-index: 1; }
    .hero-badge {
      display: inline-flex; align-items: center; gap: 7px;
      background: var(--white); border: 1px solid var(--border);
      border-radius: 100px; padding: 6px 14px;
      font-size: 12px; color: var(--green-dark); font-weight: 500;
      margin-bottom: 28px;
      box-shadow: 0 2px 8px rgba(10,94,72,0.08);
    }
    .badge-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--green-mid); animation: pulse 2s infinite; }
    @keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.6;transform:scale(1.3)} }
    .hero-title {
      font-family: var(--font-display);
      font-size: clamp(36px, 4vw, 54px);
      line-height: 1.15;
      color: var(--text-primary);
      margin-bottom: 20px;
      letter-spacing: -0.02em;
    }
    .hero-title em { font-style: italic; color: var(--green-dark); }
    .hero-sub {
      font-size: 16px; line-height: 1.7;
      color: var(--text-secondary); max-width: 420px;
      margin-bottom: 36px; font-weight: 300;
    }
    .hero-btns { display: flex; gap: 12px; flex-wrap: wrap; }
    .btn-primary {
      background: var(--green-dark); color: #fff;
      border: none; border-radius: 100px;
      padding: 13px 28px; font-size: 14px; font-weight: 500;
      cursor: pointer; font-family: var(--font-body);
      transition: all 0.2s; text-decoration: none; display: inline-block;
    }
    .btn-primary:hover { background: var(--green-mid); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(10,94,72,0.2); }
    .btn-ghost {
      background: transparent; color: var(--green-dark);
      border: 1.5px solid var(--green-dark); border-radius: 100px;
      padding: 13px 28px; font-size: 14px; font-weight: 500;
      cursor: pointer; font-family: var(--font-body);
      transition: all 0.2s; text-decoration: none; display: inline-block;
    }
    .btn-ghost:hover { background: var(--green-light); }

    .hero-right { position: relative; z-index: 1; }
    .specs-card {
      background: var(--white); border-radius: var(--radius-xl);
      border: 1px solid var(--border); padding: 28px;
      box-shadow: 0 12px 48px rgba(10,94,72,0.08);
    }
    .specs-title { font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 18px; }
    .spec-item {
      display: flex; align-items: center; gap: 14px;
      padding: 12px 0; border-bottom: 1px solid var(--border);
    }
    .spec-item:last-child { border-bottom: none; }
    .spec-icon {
      width: 38px; height: 38px; border-radius: var(--radius-sm);
      display: flex; align-items: center; justify-content: center;
      font-size: 18px; flex-shrink: 0;
    }
    .spec-info { flex: 1; }
    .spec-name { font-size: 14px; font-weight: 500; color: var(--text-primary); }
    .spec-sub { font-size: 12px; color: var(--text-secondary); margin-top: 1px; }

    /* ── STATS STRIP ── */
    .stats-strip {
      background: var(--green-dark);
      padding: 36px 48px;
      display: flex; justify-content: center; gap: 0;
    }
    .stat-block {
      flex: 1; max-width: 220px; text-align: center;
      padding: 0 32px;
      border-right: 1px solid rgba(255,255,255,0.15);
    }
    .stat-block:last-child { border-right: none; }
    .stat-block-val {
      font-family: var(--font-display);
      font-size: 52px; color: #fff;
      line-height: 1; margin-bottom: 6px;
      letter-spacing: -0.03em;
    }
    .stat-block-val span { font-size: 28px; opacity: 0.7; }
    .stat-block-label { font-size: 13px; color: rgba(255,255,255,0.6); font-weight: 300; }

    /* ── SECTION BASE ── */
    .section { padding: 80px 48px; }
    .section-label {
      font-size: 11px; font-weight: 600; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--green-mid); margin-bottom: 8px;
    }
    .section-title {
      font-family: var(--font-display); font-size: clamp(26px, 3vw, 38px);
      color: var(--text-primary); margin-bottom: 10px; letter-spacing: -0.02em;
      line-height: 1.2;
    }
    .section-sub { font-size: 15px; color: var(--text-secondary); font-weight: 300; line-height: 1.6; }

    /* ── PATOLOGÍAS ── */
    .patologias { background: var(--bg-soft); }
    .pato-header { text-align: center; margin-bottom: 48px; max-width: 560px; margin-left: auto; margin-right: auto; }
    .pato-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; max-width: 1100px; margin: 0 auto; }

    .pato-card {
      background: var(--white); border-radius: var(--radius-lg);
      border: 1px solid var(--border); padding: 28px 24px 24px;
      cursor: pointer; transition: all 0.3s;
      position: relative; overflow: hidden;
    }
    .pato-card::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px;
      opacity: 0; transition: opacity 0.3s;
    }
    .pato-card:hover { transform: translateY(-6px); box-shadow: 0 20px 48px rgba(0,0,0,0.1); border-color: transparent; }
    .pato-card:hover::before { opacity: 1; }

    /* colored card accents */
    .pato-card.sleep { border-top: 4px solid var(--card-sleep-accent); background: linear-gradient(160deg, var(--card-sleep-bg) 0%, var(--white) 60%); }
    .pato-card.gut   { border-top: 4px solid var(--card-gut-accent);   background: linear-gradient(160deg, var(--card-gut-bg) 0%, var(--white) 60%); }
    .pato-card.hormones { border-top: 4px solid var(--card-hormones-accent); background: linear-gradient(160deg, var(--card-hormones-bg) 0%, var(--white) 60%); }
    .pato-card.head  { border-top: 4px solid var(--card-head-accent);  background: linear-gradient(160deg, var(--card-head-bg) 0%, var(--white) 60%); }
    .pato-card.sport { border-top: 4px solid var(--card-sport-accent); background: linear-gradient(160deg, var(--card-sport-bg) 0%, var(--white) 60%); }

    .pato-card.sleep:hover  { box-shadow: 0 20px 48px rgba(75,114,216,0.15); }
    .pato-card.gut:hover    { box-shadow: 0 20px 48px rgba(212,106,42,0.15); }
    .pato-card.hormones:hover { box-shadow: 0 20px 48px rgba(196,78,126,0.15); }
    .pato-card.head:hover   { box-shadow: 0 20px 48px rgba(106,79,200,0.15); }
    .pato-card.sport:hover  { box-shadow: 0 20px 48px rgba(29,158,117,0.15); }

    .pato-icon-wrap {
      width: 44px; height: 44px; border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      font-size: 22px; margin-bottom: 16px;
    }
    .sleep .pato-icon-wrap  { background: rgba(75,114,216,0.12); }
    .gut .pato-icon-wrap    { background: rgba(212,106,42,0.12); }
    .hormones .pato-icon-wrap { background: rgba(196,78,126,0.12); }
    .head .pato-icon-wrap   { background: rgba(106,79,200,0.12); }
    .sport .pato-icon-wrap  { background: rgba(29,158,117,0.12); }

    .pato-question { font-family: var(--font-display); font-size: 17px; color: var(--text-primary); line-height: 1.3; margin-bottom: 10px; }
    .pato-desc { font-size: 13px; color: var(--text-secondary); line-height: 1.6; margin-bottom: 12px; font-weight: 300; }
    .pato-causes { font-size: 12px; color: var(--text-muted); margin-bottom: 16px; font-style: italic; line-height: 1.5; }

    .pato-link {
      font-size: 12.5px; font-weight: 600;
      display: inline-flex; align-items: center; gap: 6px;
      text-decoration: none; padding: 7px 16px; border-radius: 100px;
      transition: all 0.2s;
    }
    .sleep .pato-link    { background: rgba(75,114,216,0.1);  color: var(--card-sleep-accent); }
    .gut .pato-link      { background: rgba(212,106,42,0.1);  color: var(--card-gut-accent); }
    .hormones .pato-link { background: rgba(196,78,126,0.1);  color: var(--card-hormones-accent); }
    .head .pato-link     { background: rgba(106,79,200,0.1);  color: var(--card-head-accent); }
    .sport .pato-link    { background: rgba(29,158,117,0.1);  color: var(--card-sport-accent); }

    .pato-link:hover { filter: brightness(0.9); transform: translateX(2px); }
    .pato-link::after { content: '→'; }

    .pato-card-empty {
      background: transparent; border: 1.5px dashed var(--border);
      display: flex; flex-direction: column; align-items: center;
      justify-content: center; text-align: center; min-height: 200px;
    }
    .pato-card-empty .empty-icon { font-size: 28px; margin-bottom: 12px; }
    .pato-card-empty .empty-text { font-size: 14px; color: var(--text-secondary); margin-bottom: 14px; }

    /* ── CÓMO TRABAJO ── */
    .como { background: var(--white); }
    .como-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; max-width: 1100px; margin: 0 auto; }
    .como-steps { margin-top: 32px; display: flex; flex-direction: column; gap: 0; }
    .step {
      display: flex; gap: 20px; padding: 20px 0;
      border-bottom: 1px solid var(--border); position: relative;
    }
    .step:last-child { border-bottom: none; }
    .step-num {
      width: 32px; height: 32px; border-radius: 50%;
      background: var(--green-light); color: var(--green-dark);
      font-size: 13px; font-weight: 600;
      display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .step-body {}
    .step-title { font-size: 14px; font-weight: 600; color: var(--text-primary); margin-bottom: 4px; }
    .step-desc { font-size: 13px; color: var(--text-secondary); line-height: 1.6; font-weight: 300; }

    .perfil-card {
      background: var(--bg-soft); border-radius: var(--radius-xl);
      border: 1px solid var(--border); padding: 28px;
      position: sticky; top: 88px;
    }
    .perfil-top { display: flex; align-items: center; gap: 16px; margin-bottom: 18px; }
    .perfil-avatar {
      width: 64px; height: 64px; border-radius: 50%;
      background: linear-gradient(135deg, var(--green-light), #b8ead6);
      display: flex; align-items: center; justify-content: center;
      font-size: 26px; flex-shrink: 0;
    }
    .perfil-name { font-size: 17px; font-weight: 600; color: var(--text-primary); }
    .perfil-role { font-size: 13px; color: var(--green-dark); margin-top: 2px; font-weight: 400; }
    .perfil-bio { font-size: 13.5px; color: var(--text-secondary); line-height: 1.7; margin-bottom: 18px; font-weight: 300; }
    .perfil-badges { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 20px; }
    .badge-item { font-size: 11.5px; padding: 4px 12px; border-radius: 100px; background: var(--green-light); color: var(--green-dark); font-weight: 500; }
    .perfil-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
    .stat { background: var(--white); border-radius: var(--radius-md); padding: 12px 8px; text-align: center; border: 1px solid var(--border); }
    .stat-val { font-size: 22px; font-weight: 600; color: var(--text-primary); }
    .stat-label { font-size: 11px; color: var(--text-muted); margin-top: 2px; }

    /* ── MODALIDADES ── */
    .modalidades { background: var(--green-pale); }
    .mod-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; max-width: 900px; margin: 36px auto 0; }
    .mod-card {
      background: var(--white); border-radius: var(--radius-lg);
      border: 1px solid var(--border); padding: 28px;
      text-align: center; transition: all 0.25s;
    }
    .mod-card:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(10,94,72,0.1); }
    .mod-icon { font-size: 32px; margin-bottom: 14px; }
    .mod-title { font-size: 16px; font-weight: 600; color: var(--text-primary); margin-bottom: 8px; }
    .mod-desc { font-size: 13px; color: var(--text-secondary); line-height: 1.6; font-weight: 300; }

    /* ── CTA ── */
    .cta-section {
      background: var(--green-dark);
      padding: 80px 48px; text-align: center;
      position: relative; overflow: hidden;
    }
    .cta-section::before {
      content: ''; position: absolute; top: -100px; left: 50%;
      transform: translateX(-50%);
      width: 600px; height: 600px; border-radius: 50%;
      background: radial-gradient(circle, rgba(255,255,255,0.05) 0%, transparent 70%);
      pointer-events: none;
    }
    .cta-title {
      font-family: var(--font-display); font-size: clamp(28px, 3.5vw, 44px);
      color: #fff; margin-bottom: 12px; position: relative;
    }
    .cta-sub { font-size: 16px; color: rgba(255,255,255,0.65); margin-bottom: 36px; font-weight: 300; position: relative; }
    .cta-btn {
      background: #fff; color: var(--green-dark);
      border: none; border-radius: 100px;
      padding: 15px 36px; font-size: 15px; font-weight: 600;
      cursor: pointer; font-family: var(--font-body);
      transition: all 0.2s; position: relative;
      text-decoration: none; display: inline-block;
    }
    .cta-btn:hover { transform: translateY(-2px); box-shadow: 0 12px 32px rgba(0,0,0,0.2); }
    .cta-note { font-size: 13px; color: rgba(255,255,255,0.45); margin-top: 18px; position: relative; }
    .cta-note a { color: rgba(255,255,255,0.65); text-decoration: none; }

    /* ── WHATSAPP FLOAT ── */
    .wa-float {
      position: fixed; bottom: 24px; right: 24px; z-index: 999;
      background: #25D366; color: #fff;
      border-radius: 100px; padding: 12px 22px;
      font-size: 14px; font-weight: 600; font-family: var(--font-body);
      text-decoration: none; display: flex; align-items: center; gap: 8px;
      box-shadow: 0 6px 24px rgba(37,211,102,0.4);
      transition: all 0.2s;
      animation: floatIn 0.8s 1.2s both;
    }
    .wa-float:hover { transform: translateY(-3px); box-shadow: 0 10px 32px rgba(37,211,102,0.5); }
    @keyframes floatIn { from{opacity:0;transform:translateY(20px)} to{opacity:1;transform:translateY(0)} }
    .wa-float svg { width: 20px; height: 20px; fill: #fff; flex-shrink: 0; }

    /* ── FOOTER ── */
    footer {
      padding: 24px 48px;
      border-top: 1px solid var(--border);
      display: flex; justify-content: space-between; align-items: center;
      background: var(--white);
    }
    .footer-copy { font-size: 13px; color: var(--text-muted); }
    .footer-links { display: flex; gap: 20px; }
    .footer-links a { font-size: 13px; color: var(--text-muted); text-decoration: none; transition: color 0.2s; }
    .footer-links a:hover { color: var(--green-dark); }

    /* ── ANIMATIONS ── */
    .fade-in        { opacity: 0; transform: translateY(28px); transition: opacity 0.65s ease, transform 0.65s ease; }
    .fade-left      { opacity: 0; transform: translateX(-32px); transition: opacity 0.65s ease, transform 0.65s ease; }
    .fade-right     { opacity: 0; transform: translateX(32px);  transition: opacity 0.65s ease, transform 0.65s ease; }
    .fade-in.visible, .fade-left.visible, .fade-right.visible { opacity: 1; transform: translate(0,0); }

    /* ── RESPONSIVE ── */
    @media (max-width: 900px) {
      nav { padding: 0 20px; }
      .nav-links { display: none; }
      .hero { grid-template-columns: 1fr; padding: 40px 20px; min-height: auto; }
      .hero-right { display: none; }
      .section { padding: 56px 20px; }
      .pato-grid { grid-template-columns: 1fr; }
      .como-inner { grid-template-columns: 1fr; }
      .perfil-card { position: static; }
      .mod-grid { grid-template-columns: 1fr; }
      footer { flex-direction: column; gap: 12px; text-align: center; padding: 20px; }
      .stats-strip { flex-direction: column; align-items: center; gap: 24px; padding: 40px 20px; }
      .stat-block { border-right: none; border-bottom: 1px solid rgba(255,255,255,0.15); padding: 0 0 24px; }
      .stat-block:last-child { border-bottom: none; }
      .wa-float .wa-label { display: none; }
      .wa-float { padding: 14px; border-radius: 50%; }
    }
  </style>
</head>
